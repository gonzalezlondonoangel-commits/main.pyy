# ---------------- COLORES ----------------

AZUL = "#087BFF"
AZUL_OSCURO = "#06152E"
AMARILLO = "#FFD928"
ROJO = "#F2384B"
NEGRO = "#05070B"
BLANCO = "#FFFFFF"
